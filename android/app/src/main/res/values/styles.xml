<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#F35D7B</item>
        <item name="android:navigationBarColor">#0C0D12</item>
        <item name="android:statusBarColor">#0C0D12</item>
        <item name="android:windowBackground">#0C0D12</item>
        <!-- Android 12+ system splash: same dark background and the animated
             startup logo, so the splash blends into the in-app loading panel.
             Ignored on older platforms. -->
        <item name="android:windowSplashScreenBackground">#0C0D12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/startup_loading</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>
